SPEC_SHEETS_DATABASE_URL=postgresql+psycopg://spec_sheets:spec_sheets@127.0.0.1:5432/spec_sheets
SPEC_SHEETS_SEED_DEMO_DATA=true
SPEC_SHEETS_REQUIRE_SCHEMA=true
SPEC_SHEETS_ENVIRONMENT=development
SPEC_SHEETS_PUBLIC_BASE_PATH=
SPEC_SHEETS_SESSION_SECRET=replace-with-a-long-random-secret
SPEC_SHEETS_SESSION_COOKIE_NAME=spec_sheets_session

# --- Microsoft Entra ID (Azure AD) sign-in ---
# From the App Registration in the Microsoft Entra admin center.
SPEC_SHEETS_MICROSOFT_TENANT_ID=
SPEC_SHEETS_MICROSOFT_CLIENT_ID=
SPEC_SHEETS_MICROSOFT_CLIENT_SECRET=
# Optional: leave blank to auto-derive "{scheme}://{host}{PUBLIC_BASE_PATH}/api/auth/microsoft/callback".
# Whatever is effectively used MUST be registered verbatim as a Web redirect URI in Azure.
SPEC_SHEETS_MICROSOFT_REDIRECT_URI=

# Login-method toggles. Microsoft is forced as the only option by default.
# To temporarily bring back the old flows (e.g. to bootstrap the first accounts),
# set the relevant flag to true.
SPEC_SHEETS_PASSWORD_LOGIN_ENABLED=false
